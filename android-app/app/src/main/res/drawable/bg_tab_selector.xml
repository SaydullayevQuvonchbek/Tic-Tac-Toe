<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pill_cyan_bg" />
            <stroke android:width="1dp" android:color="@color/pill_cyan_stroke" />
            <corners android:radius="11dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pill_cyan_bg" />
            <stroke android:width="1dp" android:color="@color/pill_cyan_stroke" />
            <corners android:radius="11dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pill_muted_bg" />
            <stroke android:width="1dp" android:color="@color/tab_stroke" />
            <corners android:radius="11dp" />
        </shape>
    </item>
</selector>
