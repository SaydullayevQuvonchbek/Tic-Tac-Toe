<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/layoutStoreHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBackStore"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-black"
            android:text="🛍️ MARKAZIY DO'KON"
            android:textColor="@color/white"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvStoreCoins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_pill"
            android:backgroundTint="#1E293B"
            android:fontFamily="sans-serif-black"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="🪙 0"
            android:textColor="#FBBF24"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Category Tabs (Horizontal Scroll) -->
    <HorizontalScrollView
        android:id="@+id/hsvCategories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@+id/layoutStoreHeader">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCatChess"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#2563EB"
                android:fontFamily="sans-serif-black"
                android:text="👑 Shaxmat"
                android:textColor="@color/white"
                android:textSize="13sp"
                app:cornerRadius="12dp" />

            <Button
                android:id="@+id/btnCatCheckers"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#1E293B"
                android:fontFamily="sans-serif-black"
                android:text="♟️ Shashka"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                app:cornerRadius="12dp" />

            <Button
                android:id="@+id/btnCatEmotes"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#1E293B"
                android:fontFamily="sans-serif-black"
                android:text="😎 Emojilar"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                app:cornerRadius="12dp" />

            <Button
                android:id="@+id/btnCatThemes"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:backgroundTint="#1E293B"
                android:fontFamily="sans-serif-black"
                android:text="🎨 O'yin Mavzulari"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Sub-tab Switcher (e.g. Boards vs Pieces) -->
    <LinearLayout
        android:id="@+id/layoutSubTabs"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/badge_pill"
        android:backgroundTint="#0F172A"
        android:orientation="horizontal"
        android:padding="3dp"
        app:layout_constraintTop_toBottomOf="@+id/hsvCategories">

        <Button
            android:id="@+id/btnSubTab1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="#334155"
            android:fontFamily="sans-serif-black"
            android:text="🏁 Doska Ranglari"
            android:textColor="@color/white"
            android:textSize="12sp"
            app:cornerRadius="10dp" />

        <Button
            android:id="@+id/btnSubTab2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="@android:color/transparent"
            android:fontFamily="sans-serif-black"
            android:text="♟️ Toshlar Stillari"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            app:cornerRadius="10dp" />
    </LinearLayout>

    <!-- Main Content List -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutSubTabs">

        <LinearLayout
            android:id="@+id/layoutStoreItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp" />
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
