<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/layoutStoreHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="6dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBackStore"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_pill_muted"
            android:src="@drawable/ic_back"
            app:tint="@color/text_color" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/chakra_petch"
                android:text="MARKAZIY DO'KON"
                android:textColor="@color/text_color"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Doskalar · Toshlar · Emojilar · Mavzular"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStoreCoins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_gold"
            android:fontFamily="@font/chakra_petch"
            android:paddingHorizontal="12dp"
            android:paddingVertical="7dp"
            android:text="🪙 0"
            android:textColor="@color/pill_gold_text"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/hsvCategories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="16dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@+id/layoutStoreHeader">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button android:id="@+id/btnCatChess" style="@style/StoreChip" android:text="♛ SHAXMAT" />
            <Button android:id="@+id/btnCatCheckers" style="@style/StoreChip" android:layout_marginStart="7dp" android:text="⬤ SHASHKA" />
            <Button android:id="@+id/btnCatEmotes" style="@style/StoreChip" android:layout_marginStart="7dp" android:text="😎 EMOJILAR" />
            <Button android:id="@+id/btnCatThemes" style="@style/StoreChip" android:layout_marginStart="7dp" android:text="🎨 MAVZULAR" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/layoutSubTabs"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_segment_track"
        android:orientation="horizontal"
        android:padding="3dp"
        app:layout_constraintTop_toBottomOf="@+id/hsvCategories">

        <Button android:id="@+id/btnSubTab1" style="@style/StoreSegment" android:text="DOSKA RANGLARI" />
        <Button android:id="@+id/btnSubTab2" style="@style/StoreSegment" android:text="TOSHLAR STILI" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:paddingHorizontal="16dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutSubTabs">

        <LinearLayout
            android:id="@+id/layoutStoreItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp" />
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
