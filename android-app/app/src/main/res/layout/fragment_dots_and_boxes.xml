<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    tools:context=".DotsAndBoxesFragment">

    <!-- ========================================== -->
    <!-- 1. IN-FRAGMENT SETUP CONTAINER             -->
    <!-- ========================================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/setupContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp"
        android:visibility="visible">

        <ImageButton
            android:id="@+id/btnSetupBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/text_color" />

        <TextView
            android:id="@+id/tvSetupTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="🟥 Dots &amp; Boxes"
            android:textColor="@color/text_color"
            android:textSize="26sp"
            app:layout_constraintBottom_toBottomOf="@+id/btnSetupBack"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/btnSetupBack" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toTopOf="@+id/btnStartGame"
            app:layout_constraintTop_toBottomOf="@+id/tvSetupTitle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Mode Selection -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="Select Game Mode"
                    android:textColor="@color/text_color"
                    android:textSize="16sp" />

                <RadioGroup
                    android:id="@+id/rgMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rbAi"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:checked="true"
                        android:text="🤖 Play vs Smart AI Bot"
                        android:textColor="@color/text_color"
                        android:textSize="15sp" />

                    <RadioButton
                        android:id="@+id/rbLocal"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="👥 1v1 Pass &amp; Play (Same Device)"
                        android:textColor="@color/text_color"
                        android:textSize="15sp" />

                    <RadioButton
                        android:id="@+id/rbOnline"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="🌐 Online Multiplayer (Room Code)"
                        android:textColor="@color/text_color"
                        android:textSize="15sp" />
                </RadioGroup>

                <!-- Board Size Selection -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="Select Grid Size"
                    android:textColor="@color/text_color"
                    android:textSize="16sp" />

                <RadioGroup
                    android:id="@+id/rgSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rbSize3"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="⚡ 3x3 Dots (2x2 Boxes - Fast)"
                        android:textColor="@color/text_color"
                        android:textSize="15sp" />

                    <RadioButton
                        android:id="@+id/rbSize4"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:checked="true"
                        android:text="🌟 4x4 Dots (3x3 Boxes - Classic)"
                        android:textColor="@color/text_color"
                        android:textSize="15sp" />

                    <RadioButton
                        android:id="@+id/rbSize5"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="🧠 5x5 Dots (4x4 Boxes - Expert)"
                        android:textColor="@color/text_color"
                        android:textSize="15sp" />
                </RadioGroup>

                <!-- Online Sub-Options -->
                <LinearLayout
                    android:id="@+id/onlineOptionsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/btnCreateRoom"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="CREATE ROOM 🏠"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        app:backgroundTint="#0052CC"
                        app:cornerRadius="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginVertical="8dp"
                        android:text="— OR —"
                        android:textColor="#888888"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/etRoomCode"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_weight="1"
                            android:background="@drawable/edittext_bg"
                            android:gravity="center"
                            android:hint="Enter 6-char Code"
                            android:inputType="textCapCharacters"
                            android:maxLength="6"
                            android:textColor="@color/text_color" />

                        <Button
                            android:id="@+id/btnJoinRoom"
                            android:layout_width="wrap_content"
                            android:layout_height="50dp"
                            android:layout_marginStart="8dp"
                            android:text="JOIN"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            app:backgroundTint="#059669"
                            app:cornerRadius="12dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <Button
            android:id="@+id/btnStartGame"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:fontFamily="sans-serif-black"
            android:text="START GAME ▶"
            android:textColor="@color/white"
            android:textSize="18sp"
            app:backgroundTint="#0052CC"
            app:cornerRadius="16dp"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ========================================== -->
    <!-- 2. WAITING FOR ONLINE PLAYER CONTAINER     -->
    <!-- ========================================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/waitingContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/pbWaiting"
            android:layout_width="64dp"
            android:layout_height="64dp"
            app:layout_constraintBottom_toTopOf="@+id/tvWaitingTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/tvWaitingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-black"
            android:text="Waiting for Opponent..."
            android:textColor="@color/text_color"
            android:textSize="22sp"
            app:layout_constraintBottom_toTopOf="@+id/tvWaitingRoomCode"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/pbWaiting" />

        <TextView
            android:id="@+id/tvWaitingRoomCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#E0F2FE"
            android:paddingHorizontal="24dp"
            android:paddingVertical="10dp"
            android:text="ROOM: ABCD"
            android:textColor="#0369A1"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/btnInviteFriend"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvWaitingTitle" />

        <Button
            android:id="@+id/btnInviteFriend"
            android:layout_width="220dp"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-black"
            android:text="INVITE FRIEND 📲"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:backgroundTint="#0052CC"
            app:cornerRadius="14dp"
            app:layout_constraintBottom_toTopOf="@+id/btnCancelWaiting"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvWaitingRoomCode" />

        <Button
            android:id="@+id/btnCancelWaiting"
            android:layout_width="220dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="CANCEL"
            android:textColor="@color/white"
            app:backgroundTint="#EF4444"
            app:cornerRadius="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnInviteFriend" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ========================================== -->
    <!-- 3. GAMEPLAY CONTAINER                      -->
    <!-- ========================================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/gameplayContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- Top Bar -->
        <ImageButton
            android:id="@+id/btnGameplayBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/text_color" />

        <TextView
            android:id="@+id/tvGameTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="Dots &amp; Boxes"
            android:textColor="@color/text_color"
            android:textSize="22sp"
            app:layout_constraintBottom_toBottomOf="@+id/btnGameplayBack"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/btnGameplayBack" />

        <!-- Scoreboard -->
        <LinearLayout
            android:id="@+id/scoreboardContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/btnGameplayBack">

            <!-- Player 1 Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardP1"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                app:cardBackgroundColor="#06B6D4"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvP1Name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Player 1"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvP1Score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="0"
                        android:textColor="@color/white"
                        android:textSize="26sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:fontFamily="sans-serif-black"
                android:text="VS"
                android:textColor="#94A3B8"
                android:textSize="16sp" />

            <!-- Player 2 / Bot Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardP2"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                app:cardBackgroundColor="#F59E0B"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvP2Name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Bot"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvP2Score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="0"
                        android:textColor="@color/white"
                        android:textSize="26sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Turn Indicator -->
        <TextView
            android:id="@+id/tvTurnIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-bold"
            android:text="Your Turn"
            android:textColor="@color/text_color"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/scoreboardContainer" />

        <!-- Custom Canvas Game Board -->
        <com.example.tictactoe.DotsAndBoxesView
            android:id="@+id/dotsAndBoxesView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTurnIndicator" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
