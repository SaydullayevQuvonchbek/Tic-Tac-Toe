<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    tools:context=".ResultFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="26dp"
            android:paddingBottom="20dp">

            <!-- Trophy -->
            <ImageView
                android:id="@+id/ivResult"
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_gravity="center_horizontal"
                android:scaleType="fitCenter"
                android:src="@drawable/trophy" />

            <TextView
                android:id="@+id/tvHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/chakra_petch"
                android:text="WINNER"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.15" />

            <TextView
                android:id="@+id/tvResultMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/chakra_petch"
                android:gravity="center"
                android:text="G'ALABA!"
                android:textColor="@color/text_color"
                android:textSize="30sp"
                android:textStyle="bold"
                android:letterSpacing="0.02" />

            <TextView
                android:id="@+id/tvSubMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center"
                android:text="Congrats on being the undisputed champion!"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- Stat tiles -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout style="@style/ResultStat" android:background="@drawable/bg_pill_cyan">
                    <TextView android:id="@+id/tvStatXp" style="@style/ResultStatValue" android:textColor="@color/accent_cyan" android:text="+0" />
                    <TextView style="@style/ResultStatLabel" android:text="XP" />
                </LinearLayout>

                <LinearLayout style="@style/ResultStat" android:layout_marginStart="9dp" android:background="@drawable/bg_pill_gold">
                    <TextView android:id="@+id/tvStatCoins" style="@style/ResultStatValue" android:textColor="@color/accent_gold" android:text="+0" />
                    <TextView style="@style/ResultStatLabel" android:text="TANGA" />
                </LinearLayout>

                <LinearLayout style="@style/ResultStat" android:layout_marginStart="9dp" android:background="@drawable/bg_pill_red">
                    <TextView android:id="@+id/tvStatStreak" style="@style/ResultStatValue" android:textColor="@color/accent_red" android:text="🔥 0" />
                    <TextView style="@style/ResultStatLabel" android:text="STREAK" />
                </LinearLayout>
            </LinearLayout>

            <!-- Level progress -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_arena_card"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvLevelRange"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/chakra_petch"
                        android:text="LEVEL 1 → 2"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.10" />

                    <TextView
                        android:id="@+id/tvLevelXp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/chakra_petch"
                        android:text="0/500 XP"
                        android:textColor="@color/accent_cyan"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pbLevel"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="10dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_xp" />

                <LinearLayout
                    android:id="@+id/rowQuestDone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:paddingTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_pill_cyan"
                        android:gravity="center"
                        android:text="⚡"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Natija saqlandi"
                            android:textColor="@color/text_color"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvQuestDoneSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Reyting va quest progressi yangilandi"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Rematch notice -->
            <TextView
                android:id="@+id/tvRematchStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_pill_cyan"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:paddingVertical="9dp"
                android:text="⚡ Opponent requested a rematch!"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnAction"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/chakra_petch"
                    android:text="↻ QAYTA O'YIN"
                    android:textAllCaps="false"
                    android:textColor="@color/on_accent"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    app:backgroundTint="@color/accent_cyan"
                    app:cornerRadius="15dp" />

                <TextView
                    android:id="@+id/btnSecondary"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="9dp"
                    android:background="@drawable/bg_pill_muted"
                    android:gravity="center"
                    android:text="🏠"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/btnShare"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="9dp"
                    android:background="@drawable/bg_pill_muted"
                    android:gravity="center"
                    android:text="↗"
                    android:textColor="@color/text_color"
                    android:textSize="17sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <nl.dionsegijn.konfetti.xml.KonfettiView
        android:id="@+id/konfettiView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
