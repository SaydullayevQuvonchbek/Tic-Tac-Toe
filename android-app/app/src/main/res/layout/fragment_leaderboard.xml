<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    tools:context=".LeaderboardFragment">

    <!-- Header Container with Title and Compact Corner User Rank Badge -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/chakra_petch"
                    android:text="REYTINGLAR"
                    android:textColor="@color/text_color"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Season 4 · Jonli yangilanish"
                    android:textColor="@color/text_secondary"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <!-- Compact Corner Badge for User Rank (Non-intrusive) -->
            <LinearLayout
                android:id="@+id/cardMyRankCompact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_gold"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="9dp"
                android:paddingVertical="5dp">

                <TextView
                    android:id="@+id/tvMyRankMini"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/chakra_petch"
                    android:text="Siz: #1"
                    android:textColor="@color/pill_gold_text"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMyXpMini"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="@font/chakra_petch"
                    android:text="· 0 XP"
                    android:textColor="@color/pill_gold_text"
                    android:textSize="10.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Segment Tabs: Global / Friends / League -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_segment_track"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView android:id="@+id/tabGlobal" style="@style/RankTab" android:text="GLOBAL" />
            <TextView android:id="@+id/tabFriends" style="@style/RankTab" android:text="DO'STLAR" />
            <TextView android:id="@+id/tabLeague" style="@style/RankTab" android:text="LIGA" />
        </LinearLayout>
    </LinearLayout>

    <!-- Dynamic Top Section (Podium for Global, Header for Friends, Card for League) -->
    <FrameLayout
        android:id="@+id/dynamicHeaderContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/headerContainer">

        <!-- Global Tab: Podium for Top 3 -->
        <LinearLayout
            android:id="@+id/podiumContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp">

            <LinearLayout style="@style/PodiumCol">
                <TextView android:id="@+id/podium2Ini" style="@style/PodiumAvatar" android:text="SD" />
                <TextView android:id="@+id/podium2Name" style="@style/PodiumName" android:text="—" />
                <TextView android:id="@+id/podium2Xp" style="@style/PodiumXp" android:text="0 XP" />
                <TextView style="@style/PodiumStep" android:layout_height="52dp" android:text="2" />
            </LinearLayout>

            <LinearLayout style="@style/PodiumCol" android:layout_marginHorizontal="10dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="👑" android:textSize="16sp" />
                <TextView android:id="@+id/podium1Ini" style="@style/PodiumAvatar" android:layout_width="54dp" android:layout_height="54dp" android:background="@drawable/bg_result_trophy" android:textColor="#3B2508" android:text="JB" />
                <TextView android:id="@+id/podium1Name" style="@style/PodiumName" android:textSize="12sp" android:text="—" />
                <TextView android:id="@+id/podium1Xp" style="@style/PodiumXp" android:textColor="@color/accent_gold" android:text="0 XP" />
                <TextView style="@style/PodiumStep" android:layout_height="72dp" android:textColor="@color/accent_gold" android:textSize="20sp" android:text="1" />
            </LinearLayout>

            <LinearLayout style="@style/PodiumCol">
                <TextView android:id="@+id/podium3Ini" style="@style/PodiumAvatar" android:text="NM" />
                <TextView android:id="@+id/podium3Name" style="@style/PodiumName" android:text="—" />
                <TextView android:id="@+id/podium3Xp" style="@style/PodiumXp" android:text="0 XP" />
                <TextView style="@style/PodiumStep" android:layout_height="42dp" android:text="3" />
            </LinearLayout>
        </LinearLayout>

        <!-- Friends Tab Header (shown only in Friends tab) -->
        <LinearLayout
            android:id="@+id/friendsHeaderContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvFriendsCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/chakra_petch"
                android:text="DO'STLARINGIZ (5)"
                android:textColor="@color/text_color"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnAddFriend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_cyan"
                android:fontFamily="@font/chakra_petch"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="+ DO'ST QO'SHISH"
                android:textColor="@color/accent_cyan"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- League Tab Container (shown only in League tab) -->
        <LinearLayout
            android:id="@+id/leagueContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:visibility="gone">

            <!-- League Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero_arena"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvLeagueBadgeIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🥇"
                        android:textSize="26sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvCurrentLeagueName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/chakra_petch"
                            android:text="OLTIN LIGASI"
                            android:textColor="@color/arena_hero_text"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvLeagueTierDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Yuqori mahoratli chempionlar"
                            android:textColor="#C7D2FE"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvLeagueSeasonTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_cyan"
                        android:fontFamily="@font/chakra_petch"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="3dp"
                        android:text="⏳ 6 KUN"
                        android:textColor="@color/accent_cyan"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pbLeagueProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="12dp"
                    android:max="1000"
                    android:progress="450"
                    android:progressDrawable="@drawable/progress_xp" />

                <TextView
                    android:id="@+id/tvLeagueProgressText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="@font/chakra_petch"
                    android:text="Olmos ligaga o'tish uchun yana 350 XP kerak"
                    android:textColor="#C7D2FE"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/chakra_petch"
                android:text="LIGA DIVIZIONI · TOP 3 KO'TARILADI 🟢"
                android:textColor="@color/text_color"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/accent_cyan"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Full, clean, scrollable RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLeaderboard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dynamicHeaderContainer" />

</androidx.constraintlayout.widget.ConstraintLayout>
