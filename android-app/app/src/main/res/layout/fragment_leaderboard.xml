<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    tools:context=".LeaderboardFragment">

    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/chakra_petch"
            android:text="GLOBAL RANKING"
            android:textColor="@color/text_color"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Season 4 · reyting jonli yangilanadi"
            android:textColor="@color/text_secondary"
            android:textSize="10.5sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_segment_track"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView android:id="@+id/tabGlobal" style="@style/RankTab" android:text="GLOBAL" />
            <TextView android:id="@+id/tabFriends" style="@style/RankTab" android:text="DO'STLAR" />
            <TextView android:id="@+id/tabLeague" style="@style/RankTab" android:text="LIGA" />
        </LinearLayout>
    </LinearLayout>

    <!-- Podium -->
    <LinearLayout
        android:id="@+id/podiumContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:baselineAligned="false"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        app:layout_constraintTop_toBottomOf="@+id/headerContainer">

        <LinearLayout style="@style/PodiumCol">
            <TextView android:id="@+id/podium2Ini" style="@style/PodiumAvatar" android:text="SD" />
            <TextView android:id="@+id/podium2Name" style="@style/PodiumName" android:text="—" />
            <TextView android:id="@+id/podium2Xp" style="@style/PodiumXp" android:text="0 XP" />
            <TextView style="@style/PodiumStep" android:layout_height="52dp" android:text="2" />
        </LinearLayout>

        <LinearLayout style="@style/PodiumCol" android:layout_marginHorizontal="10dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="👑" android:textSize="16sp" />
            <TextView android:id="@+id/podium1Ini" style="@style/PodiumAvatar" android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_result_trophy" android:textColor="#3B2508" android:text="JB" />
            <TextView android:id="@+id/podium1Name" style="@style/PodiumName" android:textSize="12.5sp" android:text="—" />
            <TextView android:id="@+id/podium1Xp" style="@style/PodiumXp" android:textColor="@color/accent_gold" android:text="0 XP" />
            <TextView style="@style/PodiumStep" android:layout_height="76dp" android:textColor="@color/accent_gold" android:textSize="22sp" android:text="1" />
        </LinearLayout>

        <LinearLayout style="@style/PodiumCol">
            <TextView android:id="@+id/podium3Ini" style="@style/PodiumAvatar" android:text="NM" />
            <TextView android:id="@+id/podium3Name" style="@style/PodiumName" android:text="—" />
            <TextView android:id="@+id/podium3Xp" style="@style/PodiumXp" android:text="0 XP" />
            <TextView style="@style/PodiumStep" android:layout_height="42dp" android:text="3" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/accent_cyan"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLeaderboard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@+id/cardMyRank"
        app:layout_constraintTop_toBottomOf="@+id/podiumContainer" />

    <LinearLayout
        android:id="@+id/cardMyRank"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/bg_pro_card"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/chakra_petch"
                android:text="SIZNING O'RNINGIZ"
                android:textColor="@color/accent_violet"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <TextView
                android:id="@+id/tvMyLeagueBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/chakra_petch"
                android:text="🥉 BRONZE"
                android:textColor="@color/pill_gold_text"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvMyRank"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_avatar_gradient"
                android:fontFamily="@font/chakra_petch"
                android:gravity="center"
                android:text="#11"
                android:textColor="@color/on_accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvMyPlayerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="You (Player)"
                    android:textColor="@color/text_color"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMyStats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="0 XP • 0 Wins"
                    android:textColor="@color/text_secondary"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvMyLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/chakra_petch"
                android:text="LVL 1"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMyRankHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="🔥 Ko'proq XP yig'ib Top 10 ga chiqing!"
            android:textColor="@color/accent_gold"
            android:textSize="10.5sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
