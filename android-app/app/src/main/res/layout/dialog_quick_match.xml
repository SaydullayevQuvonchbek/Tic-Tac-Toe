<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="24dp"
    app:cardElevation="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ProgressBar
            android:id="@+id/pbMatch"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:indeterminateTint="@color/accent_cyan" />

        <TextView
            android:id="@+id/tvMatchStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/chakra_petch"
            android:gravity="center"
            android:text="⚡ Raqib qidirilmoqda..."
            android:textColor="@color/text_color"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMatchSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Onlayn lobbi tekshirilmoqda..."
            android:textColor="@color/text_secondary"
            android:textSize="12.5sp" />

        <!-- Fallback Action Buttons (shown when no opponent is found) -->
        <LinearLayout
            android:id="@+id/layoutNotFoundActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnPlayWithBot"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/btn_gradient_cyan"
                android:fontFamily="@font/chakra_petch"
                android:gravity="center"
                android:text="🤖 BOT BILAN O'YNASH"
                android:textColor="@color/on_accent"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/btnRetryMatch"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_pill_muted"
                android:fontFamily="@font/chakra_petch"
                android:gravity="center"
                android:text="🔄 QAYTA IZLASH"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnCancelMatch"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/chakra_petch"
            android:text="Bekor qilish"
            android:textColor="#EF4444"
            android:textSize="12sp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
