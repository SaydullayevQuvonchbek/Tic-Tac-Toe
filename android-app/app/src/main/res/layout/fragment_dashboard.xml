<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:fillViewport="true"
    android:scrollbars="none"
    tools:context=".DashboardFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="28dp">

        <!-- ===== Player header ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_avatar_gradient">

                <TextView
                    android:id="@+id/tvAvatarInitials"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/chakra_petch"
                    android:gravity="center"
                    android:text="AZ"
                    android:textColor="@color/on_accent"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvUsername"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="180dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Guest Player"
                        android:textColor="@color/text_color"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvLeagueBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:background="@drawable/bg_pill_gold"
                        android:fontFamily="@font/chakra_petch"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:text="🥉 BRONZE"
                        android:textColor="@color/pill_gold_text"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ProgressBar
                        android:id="@+id/pbXp"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="6dp"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="34"
                        android:progressDrawable="@drawable/progress_xp" />

                    <TextView
                        android:id="@+id/tvLevelInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/chakra_petch"
                        android:text="LVL 1 · 0 XP"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Stat pills row ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCoins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_gold"
                android:drawablePadding="5dp"
                android:fontFamily="@font/chakra_petch"
                android:paddingHorizontal="11dp"
                android:paddingVertical="7dp"
                android:text="🪙 0"
                android:textColor="@color/pill_gold_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStreak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:background="@drawable/bg_pill_red"
                android:fontFamily="@font/chakra_petch"
                android:paddingHorizontal="11dp"
                android:paddingVertical="7dp"
                android:text="🔥 0"
                android:textColor="@color/pill_red_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnQuickSound"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_pill_muted"
                android:gravity="center"
                android:text="🔊"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnQuickVibration"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/bg_pill_muted"
                android:gravity="center"
                android:text="📳"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnEditProfile"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/bg_pill_muted"
                android:gravity="center"
                android:text="⚙"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- ===== Quick Match hero ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_hero_arena"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/chakra_petch"
                        android:text="● 12 480 ONLAYN"
                        android:textColor="@color/online_green"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.10" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/chakra_petch"
                        android:text="QUICK\nMATCH"
                        android:textColor="@color/arena_hero_text"
                        android:textSize="25sp"
                        android:textStyle="bold"
                        android:lineSpacingMultiplier="1.0"
                        android:letterSpacing="-0.02" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:maxWidth="190dp"
                        android:text="Bir tegishda raqib topamiz — o'rtacha 8 soniya"
                        android:textColor="#C7D2FE"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_muted"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <View android:layout_width="12dp" android:layout_height="12dp" android:layout_margin="2dp" android:background="#40FFFFFF" />
                        <View android:layout_width="12dp" android:layout_height="12dp" android:layout_margin="2dp" android:background="@color/accent_cyan" />
                        <View android:layout_width="12dp" android:layout_height="12dp" android:layout_margin="2dp" android:background="#40FFFFFF" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <View android:layout_width="12dp" android:layout_height="12dp" android:layout_margin="2dp" android:background="#40FFFFFF" />
                        <View android:layout_width="12dp" android:layout_height="12dp" android:layout_margin="2dp" android:background="@color/accent_red" />
                        <View android:layout_width="12dp" android:layout_height="12dp" android:layout_margin="2dp" android:background="#40FFFFFF" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <View android:layout_width="12dp" android:layout_height="12dp" android:layout_margin="2dp" android:background="@color/accent_cyan" />
                        <View android:layout_width="12dp" android:layout_height="12dp" android:layout_margin="2dp" android:background="#40FFFFFF" />
                        <View android:layout_width="12dp" android:layout_height="12dp" android:layout_margin="2dp" android:background="@color/accent_red" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnQuickPlay"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_gradient_cyan"
                    android:fontFamily="@font/chakra_petch"
                    android:gravity="center"
                    android:text="▶ O'YNASH"
                    android:textColor="@color/on_accent"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/btnQuickFriends"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="9dp"
                    android:background="@drawable/bg_pill_muted"
                    android:gravity="center"
                    android:text="👥"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/btnQuickRoomId"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="9dp"
                    android:background="@drawable/bg_pill_muted"
                    android:fontFamily="@font/chakra_petch"
                    android:gravity="center"
                    android:text="#ID"
                    android:textColor="@color/accent_violet"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Reward row ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/cardDailyReward"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_arena_card_sm"
                android:orientation="vertical"
                android:padding="11dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎁" android:textSize="19sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Daily Bonus" android:textColor="@color/text_color" android:textSize="11.5sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:fontFamily="@font/chakra_petch" android:text="+100 OLISH" android:textColor="@color/accent_gold" android:textSize="10sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardLuckyWheel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:background="@drawable/bg_arena_card_sm"
                android:orientation="vertical"
                android:padding="11dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎡" android:textSize="19sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Lucky Wheel" android:textColor="@color/text_color" android:textSize="11.5sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:fontFamily="@font/chakra_petch" android:text="BEPUL SPIN" android:textColor="@color/accent_violet" android:textSize="10sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardSeasonPass"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:background="@drawable/bg_arena_card_sm"
                android:orientation="vertical"
                android:padding="11dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏅" android:textSize="19sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Season Pass" android:textColor="@color/text_color" android:textSize="11.5sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:fontFamily="@font/chakra_petch" android:text="14 KUN" android:textColor="@color/accent_cyan" android:textSize="10sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Daily Quest ===== -->
        <LinearLayout
            android:id="@+id/cardDailyQuests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_arena_card"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/chakra_petch"
                    android:text="KUNLIK QUEST"
                    android:textColor="@color/text_color"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10" />

                <TextView
                    android:id="@+id/tvQuestsCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_cyan"
                    android:fontFamily="@font/chakra_petch"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="3dp"
                    android:text="⏳ 00:00:00"
                    android:textColor="@color/accent_cyan"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- quest 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvQuest1Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="Quest 1"
                        android:textColor="@color/text_color"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/pbQuest1"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:layout_marginTop="6dp"
                        android:max="1"
                        android:progressDrawable="@drawable/progress_quest" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnClaimQuest1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_pill_cyan"
                    android:fontFamily="@font/chakra_petch"
                    android:minWidth="56dp"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:text="+60"
                    android:textColor="@color/accent_cyan"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- quest 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvQuest2Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="Quest 2"
                        android:textColor="@color/text_color"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/pbQuest2"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:layout_marginTop="6dp"
                        android:max="1"
                        android:progressDrawable="@drawable/progress_quest" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnClaimQuest2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_pill_cyan"
                    android:fontFamily="@font/chakra_petch"
                    android:minWidth="56dp"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:text="+50"
                    android:textColor="@color/accent_cyan"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- quest 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvQuest3Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="Quest 3"
                        android:textColor="@color/text_color"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/pbQuest3"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:layout_marginTop="6dp"
                        android:max="1"
                        android:progressDrawable="@drawable/progress_quest" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnClaimQuest3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_pill_cyan"
                    android:fontFamily="@font/chakra_petch"
                    android:minWidth="56dp"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:text="+100"
                    android:textColor="@color/accent_cyan"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Category tabs ===== -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabAll"
                    style="@style/DashTab"
                    android:text="HAMMASI 13" />

                <TextView
                    android:id="@+id/tabBattle"
                    style="@style/DashTab"
                    android:layout_marginStart="7dp"
                    android:text="⚔ 1V1 ARENA" />

                <TextView
                    android:id="@+id/tabBrain"
                    style="@style/DashTab"
                    android:layout_marginStart="7dp"
                    android:text="🧠 PUZZLE" />

                <TextView
                    android:id="@+id/tabSpeed"
                    style="@style/DashTab"
                    android:layout_marginStart="7dp"
                    android:text="⚡ SPEED" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- ===== Recommended carousel ===== -->
        <LinearLayout
            android:id="@+id/rowRecommended"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/chakra_petch"
                android:text="TAVSIYA ETILADI"
                android:textColor="@color/text_color"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/carouselRecommended"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout android:id="@+id/recChess" style="@style/RecCard">
                    <View style="@style/RecCardTop" android:background="#769656" />
                    <TextView style="@style/RecCardGlyph" android:text="♛" />
                    <TextView style="@style/RecCardName" android:text="Shaxmat" />
                    <TextView style="@style/RecCardMeta" android:text="Onlayn · AI Bot" />
                </LinearLayout>

                <LinearLayout android:id="@+id/recCheckers" style="@style/RecCard" android:layout_marginStart="12dp">
                    <View style="@style/RecCardTop" android:background="#B91C1C" />
                    <TextView style="@style/RecCardGlyph" android:text="⬤" />
                    <TextView style="@style/RecCardName" android:text="Shashka" />
                    <TextView style="@style/RecCardMeta" android:text="Checkers · 1v1" />
                </LinearLayout>

                <LinearLayout android:id="@+id/recConnect4" style="@style/RecCard" android:layout_marginStart="12dp">
                    <View style="@style/RecCardTop" android:background="#1D4ED8" />
                    <TextView style="@style/RecCardGlyph" android:text="🔴" />
                    <TextView style="@style/RecCardName" android:text="Connect 4" />
                    <TextView style="@style/RecCardMeta" android:text="Onlayn · Xona kodi" />
                </LinearLayout>

                <LinearLayout android:id="@+id/recWaterSort" style="@style/RecCard" android:layout_marginStart="12dp">
                    <View style="@style/RecCardTop" android:background="#0D9488" />
                    <TextView style="@style/RecCardGlyph" android:text="🧪" />
                    <TextView style="@style/RecCardName" android:text="Water Sort" />
                    <TextView style="@style/RecCardMeta" android:text="30 daraja kampaniya" />
                </LinearLayout>

                <LinearLayout android:id="@+id/rec2048" style="@style/RecCard" android:layout_marginStart="12dp">
                    <View style="@style/RecCardTop" android:background="#0284C7" />
                    <TextView style="@style/RecCardGlyph" android:text="🔢" />
                    <TextView style="@style/RecCardName" android:text="2048 Classic" />
                    <TextView style="@style/RecCardMeta" android:text="Cheksiz rejim" />
                </LinearLayout>

                <LinearLayout android:id="@+id/recGomoku" style="@style/RecCard" android:layout_marginStart="12dp">
                    <View style="@style/RecCardTop" android:background="#475569" />
                    <TextView style="@style/RecCardGlyph" android:text="⚫" />
                    <TextView style="@style/RecCardName" android:text="Gomoku" />
                    <TextView style="@style/RecCardMeta" android:text="5 tosh qatorda · AI" />
                </LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- ===== All games ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/chakra_petch"
                android:text="BARCHA O'YINLAR"
