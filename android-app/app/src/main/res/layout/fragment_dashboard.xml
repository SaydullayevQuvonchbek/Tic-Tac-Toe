<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <!-- Profile Header -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#312E81"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/ivAvatar"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@android:drawable/ic_menu_myplaces"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="#A5B4FC" />

                    <TextView
                        android:id="@+id/tvUsername"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:fontFamily="sans-serif-black"
                        android:text="Guest Player"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        app:layout_constraintEnd_toStartOf="@+id/btnEditProfile"
                        app:layout_constraintStart_toEndOf="@+id/ivAvatar"
                        app:layout_constraintTop_toTopOf="@+id/ivAvatar" />

                    <TextView
                        android:id="@+id/tvLevelInfo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="4dp"
                        android:text="Level 1 | 0 XP"
                        android:textColor="#A5B4FC"
                        android:textSize="14sp"
                        app:layout_constraintEnd_toStartOf="@+id/btnEditProfile"
                        app:layout_constraintStart_toEndOf="@+id/ivAvatar"
                        app:layout_constraintTop_toBottomOf="@+id/tvUsername" />
                        
                    <!-- Streak and Coins -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:layout_marginStart="16dp"
                        app:layout_constraintStart_toEndOf="@+id/ivAvatar"
                        app:layout_constraintTop_toBottomOf="@+id/tvLevelInfo">
                        
                        <TextView
                            android:id="@+id/tvStreak"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔥 0"
                            android:textColor="#F59E0B"
                            android:textStyle="bold"
                            android:textSize="14sp" />
                            
                        <TextView
                            android:id="@+id/tvCoins"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="🪙 0"
                            android:textColor="#FCD34D"
                            android:textStyle="bold"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvLeagueBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="🥉 Bronze"
                            android:textColor="#38BDF8"
                            android:textStyle="bold"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnEditProfile"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_menu_edit"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="#A5B4FC" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- Daily Reward Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardDailyReward"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#F59E0B"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                app:layout_constraintTop_toBottomOf="@+id/cardProfile">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎁"
                        android:textSize="32sp" />
                        
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Daily Reward"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:textSize="18sp" />
                            
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tap to claim your daily bonus!"
                            android:textColor="#FEF3C7"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Daily Quests Hub Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardDailyQuests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:layout_constraintTop_toBottomOf="@+id/cardDailyReward">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvDailyQuestsTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="@string/daily_quests_title"
                            android:textColor="@color/text_color"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tvQuestsCountdown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⏳ 00:00:00"
                            android:textColor="#38BDF8"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Quest 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvQuest1Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🎯 Gomoku/Shashka (0/2)"
                                android:textColor="@color/text_color"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <ProgressBar
                                android:id="@+id/pbQuest1"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="8dp"
                                android:layout_marginTop="4dp"
                                android:max="2"
                                android:progress="0"
                                android:progressTint="#10B981" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/btnClaimQuest1"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:layout_marginStart="12dp"
                            android:text="+60 🪙"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            app:backgroundTint="#059669"
                            app:cornerRadius="10dp" />
                    </LinearLayout>

                    <!-- Quest 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvQuest2Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="💧 Water Sort (0/2)"
                                android:textColor="@color/text_color"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <ProgressBar
                                android:id="@+id/pbQuest2"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="8dp"
                                android:layout_marginTop="4dp"
                                android:max="2"
                                android:progress="0"
                                android:progressTint="#06B6D4" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/btnClaimQuest2"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:layout_marginStart="12dp"
                            android:text="+50 🪙"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            app:backgroundTint="#059669"
                            app:cornerRadius="10dp" />
                    </LinearLayout>

                    <!-- Quest 3 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvQuest3Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🌐 Online Match (0/1)"
                                android:textColor="@color/text_color"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <ProgressBar
                                android:id="@+id/pbQuest3"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="8dp"
                                android:layout_marginTop="4dp"
                                android:max="1"
                                android:progress="0"
                                android:progressTint="#F59E0B" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/btnClaimQuest3"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:layout_marginStart="12dp"
                            android:text="+100 🪙"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            app:backgroundTint="#059669"
                            app:cornerRadius="10dp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:fontFamily="sans-serif-black"
                android:text="MINI GAMES HUB"
                android:textColor="@color/text_color"
                android:textSize="24sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cardDailyQuests" />

            <!-- Game Cards -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@+id/tvTitle">

                <!-- Tic Tac Toe Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardTicTacToe"
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#009688"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎮 Tic Tac Toe PRO"
                            android:textColor="@color/white"
                            android:textSize="20sp"
                            android:fontFamily="sans-serif-black"/>

                        <TextView
                            android:id="@+id/tvRecordTicTacToe"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="🏆 Wins: 0"
                            android:textColor="#E0F2F1"
                            android:textSize="13sp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Math Game Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardMathGame"
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#FF9800"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✖️ Math Master"
                            android:textColor="@color/white"
                            android:textSize="20sp"
                            android:fontFamily="sans-serif-black"/>

                        <TextView
                            android:id="@+id/tvRecordMath"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="⭐ Best Score: 0 pts"
                            android:textColor="#FFF3E0"
                            android:textSize="13sp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Memory Game Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardMemoryGame"
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#E91E63"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvMemoryGame"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔒 🧠 Memory Game"
                            android:textColor="@color/white"
                            android:textSize="20sp"
                            android:fontFamily="sans-serif-black"/>

                        <TextView
                            android:id="@+id/tvRecordMemory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="⭐ Quickest Solve"
                            android:textColor="#FCE4EC"
                            android:textSize="13sp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Color Match Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardColorMatch"
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#9C27B0"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvColorMatch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔒 🎨 Color Match"
                            android:textColor="@color/white"
                            android:textSize="20sp"
                            android:fontFamily="sans-serif-black"/>

                        <TextView
                            android:id="@+id/tvRecordColorMatch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="⭐ High Score: 0"
                            android:textColor="#F3E5F5"
                            android:textSize="13sp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 2048 Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card2048"
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#00BCD4"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv2048"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔒 🔢 2048 Puzzle"
                            android:textColor="@color/white"
                            android:textSize="20sp"
                            android:fontFamily="sans-serif-black"/>

                        <TextView
                            android:id="@+id/tvRecord2048"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="⭐ Best Tile: 2048"
                            android:textColor="#E0F7FA"
                            android:textSize="13sp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                
                <!-- Connect 4 Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardConnect4"
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#1D4ED8"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvConnect4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔒 🔴 Connect 4 🟡"
                            android:textColor="@color/white"
                            android:textSize="20sp"
                            android:fontFamily="sans-serif-black"/>

                        <TextView
                            android:id="@+id/tvRecordConnect4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="🏆 Wins: 0"
                            android:textColor="#DBEAFE"
                            android:textSize="13sp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Water Sort Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardWaterSort"
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#0D9488"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvWaterSort"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔒 🧪 Water Sort 💧"
                            android:textColor="@color/white"
                            android:textSize="20sp"
                            android:fontFamily="sans-serif-black"/>

                        <TextView
                            android:id="@+id/tvRecordWaterSort"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="⭐ Best: 0 moves"
                            android:textColor="#CCFBF1"
                            android:textSize="13sp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Dots and Boxes Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardDotsAndBoxes"
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#E11D48"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDotsAndBoxes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔒 🟥 Dots &amp; Boxes"
                            android:textColor="@color/white"
                            android:textSize="20sp"
                            android:fontFamily="sans-serif-black"/>

                        <TextView
                            android:id="@+id/tvRecordDotsAndBoxes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="🏆 Wins: 0"
                            android:textColor="#FFE4E6"
                            android:textSize="13sp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Gomoku Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardGomoku"
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#475569"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvGomoku"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔒 ⚪⚫ Gomoku (5 in a Row)"
                            android:textColor="@color/white"
                            android:textSize="20sp"
                            android:fontFamily="sans-serif-black"/>

                        <TextView
                            android:id="@+id/tvRecordGomoku"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="🏆 Wins: 0"
                            android:textColor="#E2E8F0"
                            android:textSize="13sp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Checkers / Shashka Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardCheckers"
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#B91C1C"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvCheckers"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔒 👑 Shashka (Checkers)"
                            android:textColor="@color/white"
                            android:textSize="20sp"
                            android:fontFamily="sans-serif-black"/>

                        <TextView
                            android:id="@+id/tvRecordCheckers"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="🏆 Wins: 0"
                            android:textColor="#FEE2E2"
                            android:textSize="13sp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
