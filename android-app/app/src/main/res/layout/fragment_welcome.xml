<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    tools:context=".WelcomeFragment">

    <!-- ============ SETUP ============ -->
    <LinearLayout
        android:id="@+id/setupContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp">

            <ImageButton
                android:id="@+id/btnSetupBack"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_pill_muted"
                android:src="@drawable/ic_back"
                app:tint="@color/text_color" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSetupTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/chakra_petch"
                    android:text="TIC TAC TOE PRO"
                    android:textColor="@color/text_color"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rejim va doskani tanlang"
                    android:textColor="@color/text_secondary"
                    android:textSize="10.5sp" />
            </LinearLayout>
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="16dp">

                <TextView style="@style/SectionLabel" android:text="O'YIN REJIMI" android:layout_marginTop="6dp" android:layout_marginBottom="10dp" />

                <RadioGroup
                    android:id="@+id/rgMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton android:id="@+id/rbQuickMatch" style="@style/ModeRadio" android:checked="true" android:text="⚡   1-Tap Quick Match" />
                    <RadioButton android:id="@+id/rbAi" style="@style/ModeRadio" android:text="🤖   Smart AI Bot" />
                    <RadioButton android:id="@+id/rbLocal" style="@style/ModeRadio" android:text="👥   Pass &amp; Play" />
                    <RadioButton android:id="@+id/rbOnline" style="@style/ModeRadio" android:text="🔑   Xona kodi" />
                </RadioGroup>

                <TextView style="@style/SectionLabel" android:text="DOSKA O'LCHAMI" android:layout_marginTop="16dp" android:layout_marginBottom="10dp" />

                <RadioGroup
                    android:id="@+id/rgSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton android:id="@+id/rb3x3" style="@style/SegChip" android:checked="true" android:text="3×3" />
                    <Space android:layout_width="9dp" android:layout_height="1dp" />
                    <RadioButton android:id="@+id/rb4x4" style="@style/SegChip" android:text="4×4" />
                    <Space android:layout_width="9dp" android:layout_height="1dp" />
                    <RadioButton android:id="@+id/rb5x5" style="@style/SegChip" android:text="5×5" />
                </RadioGroup>

                <TextView style="@style/SectionLabel" android:text="QO'SHIMCHA REJIM" android:layout_marginTop="16dp" android:layout_marginBottom="6dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchInfinityMode"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="⏳ Infinity Mode (eski belgilar so'nadi)"
                    android:textColor="@color/text_color"
                    android:textSize="13sp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchArcadeMode"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="⚡ Arcade Mode (har yurishga 5s)"
                    android:textColor="@color/text_color"
                    android:textSize="13sp" />

                <!-- Bet (visual only) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_surface_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView style="@style/SectionLabel" android:text="TIKISH (BET)" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="11dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_pill_gold" android:fontFamily="@font/chakra_petch" android:paddingHorizontal="12dp" android:paddingVertical="7dp" android:text="50" android:textColor="@color/pill_gold_text" android:textSize="11sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:background="@drawable/bg_pill_muted" android:fontFamily="@font/chakra_petch" android:paddingHorizontal="12dp" android:paddingVertical="7dp" android:text="100" android:textColor="@color/text_muted" android:textSize="11sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:background="@drawable/bg_pill_muted" android:fontFamily="@font/chakra_petch" android:paddingHorizontal="12dp" android:paddingVertical="7dp" android:text="250" android:textColor="@color/text_muted" android:textSize="11sp" android:textStyle="bold" />

                        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/chakra_petch" android:text="G'olib +100" android:textColor="@color/accent_lime" android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Online sub-options -->
                <LinearLayout
                    android:id="@+id/onlineOptionsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/btnCreateRoom"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:fontFamily="@font/chakra_petch"
                        android:text="XONA OCHISH 🏠"
                        android:textAllCaps="false"
                        android:textColor="@color/on_accent"
                        android:textStyle="bold"
                        app:backgroundTint="@color/accent_cyan"
                        app:cornerRadius="14dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginVertical="8dp"
                        android:text="— YOKI —"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/etRoomCode"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_surface_card"
                            android:gravity="center"
                            android:hint="6 xonali kod"
                            android:inputType="textCapCharacters"
                            android:maxLength="6"
                            android:textColor="@color/text_color"
                            android:textColorHint="@color/text_muted" />

                        <Button
                            android:id="@+id/btnJoinRoom"
                            android:layout_width="wrap_content"
                            android:layout_height="50dp"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/chakra_petch"
                            android:text="QO'SHILISH"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            app:backgroundTint="@color/accent_purple"
                            app:cornerRadius="14dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <Button
            android:id="@+id/btnStartGame"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_margin="16dp"
            android:fontFamily="@font/chakra_petch"
            android:text="▶ BOSHLASH"
            android:textAllCaps="false"
            android:textColor="@color/on_accent"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            app:backgroundTint="@color/accent_cyan"
            app:cornerRadius="16dp" />
    </LinearLayout>

    <!-- ============ WAITING ============ -->
    <LinearLayout
        android:id="@+id/waitingContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/pbWaiting"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:indeterminateTint="@color/accent_cyan" />

        <TextView
            android:id="@+id/tvWaitingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="@font/chakra_petch"
            android:text="Raqib kutilmoqda..."
            android:textColor="@color/text_color"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWaitingRoomCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_pill_cyan"
            android:fontFamily="@font/chakra_petch"
            android:paddingHorizontal="24dp"
            android:paddingVertical="10dp"
            android:text="ROOM: ABCD"
            android:textColor="@color/accent_cyan"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

        <Button
            android:id="@+id/btnInviteFriend"
            android:layout_width="240dp"
            android:layout_height="50dp"
            android:layout_marginTop="22dp"
            android:fontFamily="@font/chakra_petch"
            android:text="📲 DO'STNI TAKLIF QILISH"
            android:textAllCaps="false"
            android:textColor="@color/on_accent"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@color/accent_cyan"
            app:cornerRadius="14dp" />

        <Button
            android:id="@+id/btnCancelWaiting"
            android:layout_width="240dp"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:text="BEKOR QILISH"
            android:textAllCaps="false"
            android:textColor="@color/accent_red"
            android:textStyle="bold"
            app:backgroundTint="@color/card_surface"
            app:cornerRadius="14dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
