<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="24dp"
    app:cardElevation="16dp">

    <LinearLayout
        android:id="@+id/dialogWheelRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="🎡 LUCKY SPIN WHEEL"
            android:textColor="@color/text_color"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tvWheelSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Spin every day to win free Coins &amp; XP!"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Wheel Container with Top Pointer -->
        <FrameLayout
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp">

            <!-- Wheel Canvas -->
            <com.example.tictactoe.LuckyWheelView
                android:id="@+id/wheelView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Top Indicator Pointer -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="-6dp"
                android:text="🔻"
                android:textSize="32sp" />
        </FrameLayout>

        <!-- Result Text or Status -->
        <TextView
            android:id="@+id/tvWheelResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 FREE SPIN AVAILABLE!"
            android:textColor="#10B981"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Spin Action Button -->
        <Button
            android:id="@+id/btnSpin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-black"
            android:text="SPIN FREE NOW! 🎰"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:backgroundTint="#F59E0B"
            app:cornerRadius="14dp" />

        <!-- Close Button -->
        <Button
            android:id="@+id/btnCloseWheel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Close"
            android:textColor="@color/text_secondary" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
