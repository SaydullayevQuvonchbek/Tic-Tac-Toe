<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#022C22">

    <!-- ========================================================= -->
    <!-- 1. SETUP SCREEN (Mode selection & Matchmaking - Design 3d) -->
    <!-- ========================================================= -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/setupContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_color"
        android:visibility="visible">

        <!-- Top App Bar -->
        <LinearLayout
            android:id="@+id/layoutSetupHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnSetupBack"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                app:tint="@color/text_color" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSetupTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.04"
                    android:text="DURAK"
                    android:textColor="@color/text_color"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Podkidnoy · 36 karta"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutSetupHeader">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Decorative Hero Card Fan (Visual Polish from 3d) -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="🂠 🂡 🂮 🂭 🂫"
                        android:textColor="#34D399"
                        android:textSize="38sp" />
                </FrameLayout>

                <!-- Mode Selection Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.1"
                    android:text="O'YIN REJIMI"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <!-- Modes RadioGroup Container -->
                <RadioGroup
                    android:id="@+id/rgMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <!-- 1. Quick Match Option -->
                    <RadioButton
                        android:id="@+id/rbQuickMatch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_arena_card_sm"
                        android:button="@null"
                        android:checked="true"
                        android:drawableStart="@drawable/ic_radio_state"
                        android:drawablePadding="12dp"
                        android:fontFamily="sans-serif-black"
                        android:padding="14dp"
                        android:text="⚡ Avto Qidiruv (1-Tap Match)"
                        android:textColor="@color/text_color"
                        android:textSize="14sp" />

                    <!-- 2. AI Bot Option -->
                    <RadioButton
                        android:id="@+id/rbAi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_arena_card_sm"
                        android:button="@null"
                        android:drawableStart="@drawable/ic_radio_state"
                        android:drawablePadding="12dp"
                        android:fontFamily="sans-serif-black"
                        android:padding="14dp"
                        android:text="🤖 Bot bilan o'ynash (Offline AI)"
                        android:textColor="@color/text_color"
                        android:textSize="14sp" />

                    <!-- 3. Create Room Option -->
                    <RadioButton
                        android:id="@+id/rbCreateRoom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_arena_card_sm"
                        android:button="@null"
                        android:drawableStart="@drawable/ic_radio_state"
                        android:drawablePadding="12dp"
                        android:fontFamily="sans-serif-black"
                        android:padding="14dp"
                        android:text="👑 Xona ochish (Do'stni taklif qilish)"
                        android:textColor="@color/text_color"
                        android:textSize="14sp" />

                    <!-- 4. Join Room Option -->
                    <RadioButton
                        android:id="@+id/rbJoinRoom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_arena_card_sm"
                        android:button="@null"
                        android:drawableStart="@drawable/ic_radio_state"
                        android:drawablePadding="12dp"
                        android:fontFamily="sans-serif-black"
                        android:padding="14dp"
                        android:text="🚪 Kod orqali xonaga kirish"
                        android:textColor="@color/text_color"
                        android:textSize="14sp" />
                </RadioGroup>

                <!-- Room Code Input (when Join is selected) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilRoomCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Xona Kodi (masalan: 7KQZ)"
                    android:visibility="gone"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:endIconContentDescription="Kodni qo'yish"
                    app:endIconDrawable="@android:drawable/ic_menu_agenda"
                    app:endIconMode="custom">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRoomCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:letterSpacing="0.25"
                        android:maxLength="6"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textAllCaps="true"
                        android:textSize="20sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Rules Info Card (2x2 Grid from Design 3d) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_arena_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.1"
                        android:text="QOIDALAR"
                        android:textColor="@color/accent_green"
                        android:textSize="11sp" />

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:columnCount="2"
                        android:rowCount="2">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_margin="3dp"
                            android:background="@drawable/bg_arena_card_sm"
                            android:orientation="vertical"
                            android:padding="9dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:text="36"
                                android:textColor="@color/text_color"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="karta (6–Tuz)"
                                android:textColor="@color/text_muted"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_margin="3dp"
                            android:background="@drawable/bg_arena_card_sm"
                            android:orientation="vertical"
                            android:padding="9dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:text="6"
                                android:textColor="@color/text_color"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="boshlang'ich qo'l"
                                android:textColor="@color/text_muted"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_margin="3dp"
                            android:background="@drawable/bg_arena_card_sm"
                            android:orientation="vertical"
                            android:padding="9dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:text="1 ZOD"
                                android:textColor="@color/accent_gold"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="kozir masti"
                                android:textColor="@color/text_muted"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_margin="3dp"
                            android:background="@drawable/bg_arena_card_sm"
                            android:orientation="vertical"
                            android:padding="9dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:text="🏆"
                                android:textColor="@color/accent_green"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="kartani tugatgan yutadi"
                                android:textColor="@color/text_muted"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </GridLayout>
                </LinearLayout>

                <!-- Start Game Action Button -->
                <Button
                    android:id="@+id/btnStartGame"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="24dp"
                    android:backgroundTint="@color/accent_green"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.04"
                    android:text="▶ O'YINNI BOSHLASH"
                    android:textColor="@color/on_accent"
                    android:textSize="14sp"
                    app:cornerRadius="16dp" />

            </LinearLayout>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ========================================================= -->
    <!-- 2. WAITING ROOM SCREEN (Clean Code Tiles from Design 3d)   -->
    <!-- ========================================================= -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/waitingContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_color"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvWaitingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.08"
            android:text="XONA YARATILDI"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="40dp" />

        <!-- Big Room Code Display -->
        <TextView
            android:id="@+id/tvCreatedRoomCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_arena_card"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.3"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:text="7KQZ"
            android:textColor="@color/accent_green"
            android:textSize="36sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvWaitingTitle" />

        <LinearLayout
            android:id="@+id/layoutWaitingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvCreatedRoomCode">

            <ProgressBar
                android:id="@+id/pbWaiting"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:indeterminateTint="@color/accent_green" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Do'st kutilmoqda…"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Copy & Share Buttons Row -->
        <LinearLayout
            android:id="@+id/layoutWaitingActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/layoutWaitingStatus">

            <Button
                android:id="@+id/btnCopyRoomCode"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/card_surface"
                android:fontFamily="sans-serif-black"
                android:text="📋 NUSXA"
                android:textColor="@color/text_color"
                android:textSize="12sp"
                app:cornerRadius="14dp" />

            <Button
                android:id="@+id/btnInviteFriend"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/accent_green"
                android:fontFamily="sans-serif-black"
                android:text="🔗 ULASHISH"
                android:textColor="@color/on_accent"
                android:textSize="12sp"
                app:cornerRadius="14dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnCancelWaiting"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/card_surface"
            android:fontFamily="sans-serif-black"
            android:text="BEKOR QILISH"
            android:textColor="@color/accent_red"
            android:textSize="12sp"
            app:cornerRadius="14dp"
            app:layout_constraintTop_toBottomOf="@+id/layoutWaitingActions" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ========================================================= -->
    <!-- 3. GAMEPLAY SCREEN (Premium Felt Card Table - Design 3a)   -->
    <!-- ========================================================= -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/gameplayContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#04382A"
        android:visibility="gone">

        <!-- Top Navigation Header -->
        <ImageButton
            android:id="@+id/btnGameplayBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_margin="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white" />

        <LinearLayout
            android:id="@+id/layoutGameTitleHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@+id/btnGameplayBack"
            app:layout_constraintEnd_toStartOf="@+id/layoutTrumpHeader"
            app:layout_constraintStart_toEndOf="@+id/btnGameplayBack"
            app:layout_constraintTop_toTopOf="@+id/btnGameplayBack">

            <TextView
                android:id="@+id/tvRoomCodeHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.06"
                android:text="DURAK · ONLAYN"
                android:textColor="@color/white"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvRoomSubHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="XONA #7KQZ"
                android:textColor="#6EE7B7"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- PROMINENT ZOD (TRUMP) BADGE PILL (Design 3a Top Right) -->
        <LinearLayout
            android:id="@+id/layoutTrumpHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_pill_gold"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="11dp"
            android:paddingVertical="5dp"
            app:layout_constraintBottom_toBottomOf="@+id/btnGameplayBack"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/btnGameplayBack">

            <TextView
                android:id="@+id/tvTrumpHeaderLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.1"
                android:text="ZOD "
                android:textColor="@color/accent_gold"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvTrumpHeaderSuit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="♥"
                android:textColor="#F87171"
                android:textSize="17sp" />
        </LinearLayout>

        <!-- Opponent Info HUD (Top Center) -->
        <LinearLayout
            android:id="@+id/layoutOpponentHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnGameplayBack">

            <!-- Opponent Initials Avatar Badge -->
            <TextView
                android:id="@+id/tvOpponentAvatar"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_avatar_gradient"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="JB"
                android:textColor="@color/white"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvOpponentName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-black"
                android:text="Jahongir"
                android:textColor="@color/white"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvOpponentCardsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_cyan"
                android:fontFamily="sans-serif-black"
                android:paddingHorizontal="9dp"
                android:paddingVertical="3dp"
                android:text="6 karta"
                android:textColor="@color/accent_cyan"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- Opponent Cards Fan (Top) -->
        <LinearLayout
            android:id="@+id/layoutOpponentCards"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/layoutOpponentHeader" />

        <!-- Center Battle Area: Deck & Trump on Left, Table Pairs on Right -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutCenterArena"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:paddingHorizontal="10dp"
            app:layout_constraintBottom_toTopOf="@+id/tvGameStatus"
            app:layout_constraintTop_toBottomOf="@+id/layoutOpponentCards">

            <!-- Deck Pile & Trump Card (Design 3a Left Side) -->
            <FrameLayout
                android:id="@+id/layoutDeckAndTrump"
                android:layout_width="72dp"
                android:layout_height="105dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Horizontal Trump Card underneath -->
                <com.example.tictactoe.DurakCardView
                    android:id="@+id/viewTrumpCard"
                    android:layout_width="56dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center_vertical|start"
                    android:rotation="90" />

                <!-- Vertical Face-Down Deck Pile on top -->
                <com.example.tictactoe.DurakCardView
                    android:id="@+id/viewDeckPile"
                    android:layout_width="56dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center_vertical|end" />

                <!-- Deck Count Badge -->
                <TextView
                    android:id="@+id/tvDeckCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:background="@drawable/bg_pill_gold"
                    android:fontFamily="sans-serif-black"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="24"
                    android:textColor="@color/accent_gold"
                    android:textSize="10sp" />
            </FrameLayout>

            <!-- Table Battle Pairs (Spacious Center Area) -->
            <HorizontalScrollView
                android:id="@+id/scrollTablePairs"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:fillViewport="true"
                android:scrollbars="none"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/layoutDeckAndTrump"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:id="@+id/layoutTablePairs"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp" />
            </HorizontalScrollView>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Turn & Game Status Banner (Design 3a Banner) -->
        <TextView
            android:id="@+id/tvGameStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_arena_card_sm"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:padding="8dp"
            android:text="SIZNING NAVBATINGIZ — KARTA TASHLANG"
            android:textColor="#FDE047"
            android:textSize="12sp"
            app:layout_constraintBottom_toTopOf="@+id/layoutActionButtons" />

        <!-- Action Buttons Row (Tashlash, Urish, Bita, Olish + Emote trigger) -->
        <LinearLayout
            android:id="@+id/layoutActionButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingBottom="4dp"
            app:layout_constraintBottom_toTopOf="@+id/scrollPlayerHand">

            <Button
                android:id="@+id/btnAttack"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="#0284C7"
                android:fontFamily="sans-serif-black"
                android:text="⚔️ Tashlash"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:cornerRadius="12dp" />

            <Button
                android:id="@+id/btnDefend"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="#16A34A"
                android:fontFamily="sans-serif-black"
                android:text="🛡️ Urish"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:cornerRadius="12dp" />

            <Button
                android:id="@+id/btnPassBita"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="#D97706"
                android:fontFamily="sans-serif-black"
                android:text="✋ Bita"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:cornerRadius="12dp" />

            <Button
                android:id="@+id/btnTakeCards"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="#DC2626"
                android:fontFamily="sans-serif-black"
                android:text="📥 Olish"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:cornerRadius="12dp" />

            <!-- Open Full Reaction Sheet Button -->
            <ImageButton
                android:id="@+id/btnOpenReaction"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_arena_card_sm"
                android:src="@android:drawable/ic_menu_send"
                app:tint="@color/accent_gold" />
        </LinearLayout>

        <!-- Player Hand (Arched fan cards area) -->
        <FrameLayout
            android:id="@+id/scrollPlayerHand"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingHorizontal="4dp"
            app:layout_constraintBottom_toTopOf="@+id/tvDragHint">

            <LinearLayout
                android:id="@+id/layoutPlayerCards"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center_horizontal|bottom"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_horizontal|bottom"
                android:orientation="horizontal"
                android:paddingBottom="4dp" />
        </FrameLayout>

        <!-- Drag to Play Hint Subtitle -->
        <TextView
            android:id="@+id/tvDragHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:text="KARTANI YUQORIGA SURING YOKI TANLANG"
            android:textColor="#80ECFDF5"
            android:textSize="9.5sp"
            app:layout_constraintBottom_toTopOf="@+id/layoutEmotesDurak" />

        <!-- 4-Reaction Quick Bar at Bottom (Design 3c) -->
        <LinearLayout
            android:id="@+id/layoutEmotesDurak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingBottom="10dp"
            android:paddingTop="4dp"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
