<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070A12">

    <!-- ========================================================= -->
    <!-- 1. SETUP SCREEN (Design 3d: Durak sozlash)                -->
    <!-- ========================================================= -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/setupContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#070A12"
        android:visibility="visible">

        <!-- Top Header Navigation -->
        <LinearLayout
            android:id="@+id/layoutSetupHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp"
            android:paddingTop="14dp"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/btnSetupBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_durak_top_btn"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="‹"
                android:textColor="#F2F5FF"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSetupTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.04"
                    android:text="DURAK"
                    android:textColor="#F2F5FF"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Podkidnoy · 36 karta"
                    android:textColor="#8492B0"
                    android:textSize="10.5sp" />
            </LinearLayout>
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:scrollbars="none"
            app:layout_constraintBottom_toTopOf="@+id/layoutSetupBottom"
            app:layout_constraintTop_toBottomOf="@+id/layoutSetupHeader">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingTop="10dp"
                android:paddingBottom="16dp">

                <!-- Decorative Overlapping Cards Fan (Design 3d) -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="88dp"
                    android:layout_marginTop="4dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="56dp"
                            android:layout_height="80dp"
                            android:background="@drawable/bg_arena_card"
                            android:fontFamily="sans-serif-black"
                            android:gravity="center"
                            android:rotation="-14"
                            android:text="T♠"
                            android:textColor="#0F172A"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="56dp"
                            android:layout_height="80dp"
                            android:layout_marginStart="-20dp"
                            android:background="@drawable/bg_arena_card"
                            android:fontFamily="sans-serif-black"
                            android:gravity="center"
                            android:rotation="-5"
                            android:text="K♥"
                            android:textColor="#DC2626"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="56dp"
                            android:layout_height="80dp"
                            android:layout_marginStart="-20dp"
                            android:background="@drawable/bg_pill_gold"
                            android:fontFamily="sans-serif-black"
                            android:gravity="center"
                            android:rotation="5"
                            android:text="T♥"
                            android:textColor="#DC2626"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="56dp"
                            android:layout_height="80dp"
                            android:layout_marginStart="-20dp"
                            android:background="@drawable/bg_arena_card"
                            android:fontFamily="sans-serif-black"
                            android:gravity="center"
                            android:rotation="14"
                            android:text="V♣"
                            android:textColor="#0F172A"
                            android:textSize="16sp" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Mode Selection Label (Design 3d) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.12"
                    android:text="O'YIN REJIMI"
                    android:textColor="#64748B"
                    android:textSize="11sp" />

                <!-- 4 Selectable Mode Cards (Design 3d) -->
                <RadioGroup
                    android:id="@+id/rgMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <!-- 1. Avto Qidiruv -->
                    <RadioButton
                        android:id="@+id/rbQuickMatch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_durak_rules_card"
                        android:button="@null"
                        android:checked="true"
                        android:drawableStart="@drawable/ic_radio_state"
                        android:drawablePadding="12dp"
                        android:fontFamily="sans-serif-black"
                        android:padding="13dp"
                        android:text="⚡  Avto qidiruv\n1-tap · o'rtacha 8 soniya"
                        android:textColor="#F2F5FF"
                        android:textSize="12.5sp" />

                    <!-- 2. Bot bilan (Offline) -->
                    <RadioButton
                        android:id="@+id/rbAi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_arena_card_sm"
                        android:button="@null"
                        android:drawableStart="@drawable/ic_radio_state"
                        android:drawablePadding="12dp"
                        android:fontFamily="sans-serif-black"
                        android:padding="13dp"
                        android:text="🤖  Bot bilan (Offline)\nDurakAI · internetsiz"
                        android:textColor="#F2F5FF"
                        android:textSize="12.5sp" />

                    <!-- 3. Xona ochish -->
                    <RadioButton
                        android:id="@+id/rbCreateRoom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_arena_card_sm"
                        android:button="@null"
                        android:drawableStart="@drawable/ic_radio_state"
                        android:drawablePadding="12dp"
                        android:fontFamily="sans-serif-black"
                        android:padding="13dp"
                        android:text="👑  Xona ochish\nDo'stni kod bilan taklif qilish"
                        android:textColor="#F2F5FF"
                        android:textSize="12.5sp" />

                    <!-- 4. Kod orqali kirish -->
                    <RadioButton
                        android:id="@+id/rbJoinRoom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_arena_card_sm"
                        android:button="@null"
                        android:drawableStart="@drawable/ic_radio_state"
                        android:drawablePadding="12dp"
                        android:fontFamily="sans-serif-black"
                        android:padding="13dp"
                        android:text="🚪  Kod orqali kirish\n4-6 belgili xona kodi"
                        android:textColor="#F2F5FF"
                        android:textSize="12.5sp" />
                </RadioGroup>

                <!-- Room Code Input (when Join is selected) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilRoomCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Xona Kodi (masalan: 7KQZ)"
                    android:visibility="gone"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:endIconContentDescription="Kodni qo'yish"
                    app:endIconDrawable="@android:drawable/ic_menu_agenda"
                    app:endIconMode="custom">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRoomCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:letterSpacing="0.25"
                        android:maxLength="6"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textAllCaps="true"
                        android:textSize="20sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Rules Info Card (Design 3d 2x2 Grid) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_durak_rules_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.12"
                        android:text="QOIDALAR"
                        android:textColor="#6EE7B7"
                        android:textSize="11sp" />

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="11dp"
                        android:columnCount="2"
                        android:rowCount="2">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_margin="3dp"
                            android:background="@drawable/bg_durak_opp_pill"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:text="36"
                                android:textColor="#F2F5FF"
                                android:textSize="15sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="karta (6–Tuz)"
                                android:textColor="#8492B0"
                                android:textSize="9.5sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_margin="3dp"
                            android:background="@drawable/bg_durak_opp_pill"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:text="6"
                                android:textColor="#F2F5FF"
                                android:textSize="15sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="boshlang'ich qo'l"
                                android:textColor="#8492B0"
                                android:textSize="9.5sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_margin="3dp"
                            android:background="@drawable/bg_durak_opp_pill"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:text="1 ZOD"
                                android:textColor="#FBBF24"
                                android:textSize="15sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="kozir masti"
                                android:textColor="#8492B0"
                                android:textSize="9.5sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_margin="3dp"
                            android:background="@drawable/bg_durak_opp_pill"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:text="🏆"
                                android:textColor="#34D399"
                                android:textSize="15sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="kartani tugatgan yutadi"
                                android:textColor="#8492B0"
                                android:textSize="9.5sp" />
                        </LinearLayout>
                    </GridLayout>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- Bottom Start Game Container (Design 3d) -->
        <LinearLayout
            android:id="@+id/layoutSetupBottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="18dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/btnStartGame"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_durak_btn_start"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:text="▶ O'YINNI BOSHLASH"
                android:textColor="#022C22"
                android:textSize="14sp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ========================================================= -->
    <!-- 2. WAITING ROOM SCREEN (Design 3d: Xona yaratildi)         -->
    <!-- ========================================================= -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/waitingContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#070A12"
        android:padding="18dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_durak_rules_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="18dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvWaitingTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.14"
                android:text="XONA YARATILDI"
                android:textColor="#64748B"
                android:textSize="10sp" />

            <!-- 4 Distinct Room Code Tiles (Design 3d: [ 7 ] [ K ] [ Q ] [ Z ]) -->
            <LinearLayout
                android:id="@+id/layoutCodeTiles"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTile1"
                    android:layout_width="38dp"
                    android:layout_height="48dp"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_durak_room_tile"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="7"
                    android:textColor="#34D399"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/tvTile2"
                    android:layout_width="38dp"
                    android:layout_height="48dp"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_durak_room_tile"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="K"
                    android:textColor="#34D399"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/tvTile3"
                    android:layout_width="38dp"
                    android:layout_height="48dp"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_durak_room_tile"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="Q"
                    android:textColor="#34D399"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/tvTile4"
                    android:layout_width="38dp"
                    android:layout_height="48dp"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_durak_room_tile"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="Z"
                    android:textColor="#34D399"
                    android:textSize="22sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCreatedRoomCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/pbWaiting"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:indeterminateTint="#34D399" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Do'st kutilmoqda…"
                    android:textColor="#8492B0"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <!-- Copy & Share Action Buttons (Design 3d) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnCopyRoomCode"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_durak_top_btn"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="📋 NUSXA"
                    android:textColor="#CBD5E1"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/btnInviteFriend"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_durak_room_tile"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="🔗 ULASHISH"
                    android:textColor="#34D399"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnCancelWaiting"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="BEKOR QILISH"
                android:textColor="#F87171"
                android:textSize="11sp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ========================================================= -->
    <!-- 3. GAMEPLAY SCREEN (Design 3a: Durak stoli)               -->
    <!-- ========================================================= -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/gameplayContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_durak_felt"
        android:visibility="gone">

        <!-- Top Header Navigation (Design 3a: ‹ DURAK · ONLAYN | ZOD ♥) -->
        <LinearLayout
            android:id="@+id/layoutTopHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingTop="10dp"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/btnGameplayBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_durak_top_btn"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="‹"
                android:textColor="#ECFDF5"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRoomCodeHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.08"
                    android:text="DURAK · ONLAYN"
                    android:textColor="#ECFDF5"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvRoomSubHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="sans-serif-black"
                    android:text="XONA #7KQZ"
                    android:textColor="#6EE7B7"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- ZOD Badge Pill (Design 3a: ZOD ♥) -->
            <LinearLayout
                android:id="@+id/layoutTrumpHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_durak_zod_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="11dp"
                android:paddingVertical="6dp">

                <TextView
                    android:id="@+id/tvTrumpHeaderLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.12"
                    android:text="ZOD"
                    android:textColor="#FBBF24"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/tvTrumpHeaderSuit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:fontFamily="sans-serif-black"
                    android:text="♥"
                    android:textColor="#F87171"
                    android:textSize="17sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Opponent Header HUD (Design 3a: [JB] Jahongir [6 karta]) -->
        <LinearLayout
            android:id="@+id/layoutOpponentHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutTopHeader">

            <TextView
                android:id="@+id/tvOpponentAvatar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_durak_opp_avatar"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="JB"
                android:textColor="#E2E8F0"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvOpponentName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:fontFamily="sans-serif-black"
                android:text="Jahongir"
                android:textColor="#ECFDF5"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvOpponentCardsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:background="@drawable/bg_durak_opp_pill"
                android:fontFamily="sans-serif-black"
                android:paddingHorizontal="9dp"
                android:paddingVertical="3dp"
                android:text="6 karta"
                android:textColor="#7DD3FC"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- Opponent Cards Fan (Design 3a: Fanned card backs) -->
        <LinearLayout
            android:id="@+id/layoutOpponentCards"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/layoutOpponentHeader" />

        <!-- Center Battle Area: Deck & Trump on Left, Table Pairs on Right (Design 3a) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutCenterArena"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:paddingHorizontal="14dp"
            app:layout_constraintBottom_toTopOf="@+id/tvGameStatus"
            app:layout_constraintTop_toBottomOf="@+id/layoutOpponentCards">

            <!-- Deck Pile & Trump Card (Design 3a: Horizontal Trump under vertical deck) -->
            <FrameLayout
                android:id="@+id/layoutDeckAndTrump"
                android:layout_width="66dp"
                android:layout_height="96dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Horizontal Trump Card underneath -->
                <com.example.tictactoe.DurakCardView
                    android:id="@+id/viewTrumpCard"
                    android:layout_width="54dp"
                    android:layout_height="76dp"
                    android:layout_gravity="center_vertical|start"
                    android:rotation="90" />

                <!-- Vertical Face-Down Deck Pile on top -->
                <com.example.tictactoe.DurakCardView
                    android:id="@+id/viewDeckPile"
                    android:layout_width="54dp"
                    android:layout_height="76dp"
                    android:layout_gravity="center_vertical|end" />

                <!-- Deck Count Badge -->
                <TextView
                    android:id="@+id/tvDeckCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:background="@drawable/bg_durak_deck_count"
                    android:fontFamily="sans-serif-black"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="24"
                    android:textColor="#FBBF24"
                    android:textSize="10sp" />
            </FrameLayout>

            <!-- Table Battle Pairs (Design 3a: Pairs area) -->
            <HorizontalScrollView
                android:id="@+id/scrollTablePairs"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:fillViewport="true"
                android:scrollbars="none"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/layoutDeckAndTrump"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:id="@+id/layoutTablePairs"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp" />
            </HorizontalScrollView>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Turn Status Banner (Design 3a: SIZ HIMOYADASIZ — URING 0:18) -->
        <LinearLayout
            android:id="@+id/layoutStatusBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_durak_status_banner"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="8dp"
            app:layout_constraintBottom_toTopOf="@+id/layoutActionButtons">

            <View
                android:id="@+id/viewStatusDot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/badge_dot_active" />

            <TextView
                android:id="@+id/tvGameStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.06"
                android:text="SIZ HIMOYADASIZ — URING"
                android:textColor="#FDE047"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvTurnTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-black"
                android:text="0:18"
                android:textColor="#6EE7B7"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Action Buttons Row (Design 3a & 3c: 🛡 URISH | 📥 OLISH | 😎) -->
        <LinearLayout
            android:id="@+id/layoutActionButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingBottom="6dp"
            app:layout_constraintBottom_toTopOf="@+id/scrollPlayerHand">

            <TextView
                android:id="@+id/btnAttack"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_durak_btn_defend"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="⚔️ TASHLASH"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnDefend"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_durak_btn_defend"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="🛡 URISH"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnPassBita"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_durak_btn_pass"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="✋ BITA"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnTakeCards"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_durak_btn_take"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="📥 OLISH"
                android:textColor="#FCA5A5"
                android:textSize="13sp" />

            <!-- Quick Reaction Button (Design 3a: 😎) -->
            <TextView
                android:id="@+id/btnOpenReaction"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_durak_btn_action_sm"
                android:gravity="center"
                android:text="😎"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Player Hand Fan (Design 3a: Fanned cards) -->
        <FrameLayout
            android:id="@+id/scrollPlayerHand"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingHorizontal="6dp"
            app:layout_constraintBottom_toTopOf="@+id/tvDragHint">

            <LinearLayout
                android:id="@+id/layoutPlayerCards"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center_horizontal|bottom"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_horizontal|bottom"
                android:orientation="horizontal"
                android:paddingBottom="2dp" />
        </FrameLayout>

        <!-- Drag to Play Subtitle (Design 3a: KARTANI YUQORIGA SURING) -->
        <TextView
            android:id="@+id/tvDragHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:letterSpacing="0.1"
            android:paddingBottom="4dp"
            android:text="KARTANI YUQORIGA SURING"
            android:textColor="#66ECFDF5"
            android:textSize="10sp"
            app:layout_constraintBottom_toTopOf="@+id/layoutEmotesDurak" />

        <!-- Quick 4 Reactions Bar (Design 3c: 🔥 😂 👏 💀 ⋯) -->
        <LinearLayout
            android:id="@+id/layoutEmotesDurak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingBottom="12dp"
            android:paddingTop="2dp"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
