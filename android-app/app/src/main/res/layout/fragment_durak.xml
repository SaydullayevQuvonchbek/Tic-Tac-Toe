<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#064E3B">

    <!-- 1. SETUP SCREEN (Mode selection & Matchmaking) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/setupContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_color"
        android:padding="20dp"
        android:visibility="visible">

        <ImageButton
            android:id="@+id/btnSetupBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/text_color" />

        <TextView
            android:id="@+id/tvSetupTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="🃏 Durak (Karta)"
            android:textColor="@color/text_color"
            android:textSize="24sp"
            app:layout_constraintBottom_toBottomOf="@+id/btnSetupBack"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/btnSetupBack" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnSetupBack">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Mode Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/card_background"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="O'YIN REJIMI"
                            android:textColor="@color/text_color"
                            android:textSize="14sp" />

                        <RadioGroup
                            android:id="@+id/rgMode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp">

                            <RadioButton
                                android:id="@+id/rbQuickMatch"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:text="⚡ Avto Qidiruv (1-Tap Match)"
                                android:textColor="@color/text_color"
                                android:textSize="15sp" />

                            <RadioButton
                                android:id="@+id/rbAi"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="🤖 Bot bilan o'ynash (Offline AI)"
                                android:textColor="@color/text_color"
                                android:textSize="15sp" />

                            <RadioButton
                                android:id="@+id/rbCreateRoom"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="👑 Xona ochish (Do'stni taklif qilish)"
                                android:textColor="@color/text_color"
                                android:textSize="15sp" />

                            <RadioButton
                                android:id="@+id/rbJoinRoom"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="🚪 Kod orqali xonaga kirish"
                                android:textColor="@color/text_color"
                                android:textSize="15sp" />
                        </RadioGroup>

                        <!-- Room Code Input (when Join is selected) -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilRoomCode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:hint="Xona Kodi (masalan: ABCD)"
                            android:visibility="gone"
                            app:boxCornerRadiusBottomEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusTopStart="12dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etRoomCode"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAllCaps="true" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Rules Info Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:cardBackgroundColor="#065F46"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="📜 PODKIDNOY DURAK QOIDALARI"
                            android:textColor="@color/white"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="• 36 ta karta (6 dan Tuzgacha)\n• Har o'yinchiga 6 tadan karta beriladi\n• 1 ta ZOD (Kozir) belgilanadi\n• Kartani bosing yoki yuqoriga SURIB tashlang!\n• Birinchi bo'lib kartalarini tugatgan yutadi 🏆"
                            android:textColor="#D1FAE5"
                            android:textSize="12sp"
                            android:lineSpacingExtra="3dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <Button
                    android:id="@+id/btnStartGame"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:backgroundTint="#059669"
                    android:fontFamily="sans-serif-black"
                    android:text="O'YINNI BOSHLASH ▶"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    app:cornerRadius="16dp" />
            </LinearLayout>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 2. WAITING CONTAINER (For Room Creation) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/waitingContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_color"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvWaitingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="Xona Yaratildi 🃏"
            android:textColor="@color/text_color"
            android:textSize="22sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Do'stingizga ushbu kodni yuboring:"
            android:textColor="@color/text_secondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvWaitingTitle" />

        <TextView
            android:id="@+id/tvCreatedRoomCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.2"
            android:text="ABCD"
            android:textColor="#10B981"
            android:textSize="36sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvWaitingTitle" />

        <ProgressBar
            android:id="@+id/pbWaiting"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginTop="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvCreatedRoomCode" />

        <Button
            android:id="@+id/btnInviteFriend"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#059669"
            android:text="🔗 Kodni Do'stga Ulashish"
            android:textColor="@color/white"
            app:cornerRadius="14dp"
            app:layout_constraintTop_toBottomOf="@+id/pbWaiting" />

        <Button
            android:id="@+id/btnCancelWaiting"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#EF4444"
            android:text="Bekor Qilish"
            android:textColor="@color/white"
            app:cornerRadius="14dp"
            app:layout_constraintTop_toBottomOf="@+id/btnInviteFriend" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 3. GAMEPLAY SCREEN (3D Green Felt Card Table) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/gameplayContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- Top Header Navigation -->
        <ImageButton
            android:id="@+id/btnGameplayBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tvRoomCodeHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="🃏 Durak"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="@+id/btnGameplayBack"
            app:layout_constraintStart_toEndOf="@+id/btnGameplayBack"
            app:layout_constraintTop_toTopOf="@+id/btnGameplayBack" />

        <!-- PROMINENT ZOD (TRUMP) BADGE (Top Right Header) -->
        <LinearLayout
            android:id="@+id/layoutTrumpHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:background="@drawable/badge_pill"
            android:backgroundTint="#0F172A"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="7dp"
            app:layout_constraintBottom_toBottomOf="@+id/btnGameplayBack"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/btnGameplayBack">

            <TextView
                android:id="@+id/tvTrumpHeaderLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="👑 ZOD: "
                android:textColor="#FBBF24"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvTrumpHeaderSuit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="♥️ Yurak"
                android:textColor="#EF4444"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Opponent Info (Top Center) -->
        <LinearLayout
            android:id="@+id/layoutOpponentHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnGameplayBack"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/tvOpponentName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="Opponent"
                android:textColor="@color/white"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvOpponentCardsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/badge_pill"
                android:backgroundTint="#0F172A"
                android:paddingHorizontal="12dp"
                android:paddingVertical="3dp"
                android:text="🂠 6 ta"
                android:textColor="#38BDF8"
                android:textStyle="bold"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Opponent Card Backs Fan (Top) -->
        <LinearLayout
            android:id="@+id/layoutOpponentCards"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/layoutOpponentHeader"
            android:layout_marginTop="2dp" />

        <!-- Center Battle Area: Deck & Trump on Left, Table Pairs on Right -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutCenterArena"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:paddingHorizontal="4dp"
            app:layout_constraintBottom_toTopOf="@+id/tvGameStatus"
            app:layout_constraintTop_toBottomOf="@+id/layoutOpponentCards">

            <!-- Deck Pile & Trump Card (Compact Left Side) -->
            <FrameLayout
                android:id="@+id/layoutDeckAndTrump"
                android:layout_width="72dp"
                android:layout_height="120dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Horizontal Trump Card underneath -->
                <com.example.tictactoe.DurakCardView
                    android:id="@+id/viewTrumpCard"
                    android:layout_width="62dp"
                    android:layout_height="90dp"
                    android:layout_gravity="center"
                    android:rotation="90" />

                <!-- Vertical Face-Down Deck Pile on top -->
                <com.example.tictactoe.DurakCardView
                    android:id="@+id/viewDeckPile"
                    android:layout_width="62dp"
                    android:layout_height="90dp"
                    android:layout_gravity="center" />

                <!-- Deck Count Badge -->
                <TextView
                    android:id="@+id/tvDeckCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:background="@drawable/badge_pill"
                    android:backgroundTint="#0F172A"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="2dp"
                    android:text="🂠 24"
                    android:textColor="#FBBF24"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Table Battle Pairs (Spacious Center Area) -->
            <HorizontalScrollView
                android:id="@+id/scrollTablePairs"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:fillViewport="true"
                android:scrollbars="none"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/layoutDeckAndTrump"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:id="@+id/layoutTablePairs"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp" />
            </HorizontalScrollView>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Turn & Game Status Indicator -->
        <TextView
            android:id="@+id/tvGameStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="6dp"
            android:fontFamily="sans-serif-black"
            android:text="Sizning navbatingiz (Hujum qiling) ⚔️"
            android:textColor="#FDE047"
            android:textSize="15sp"
            app:layout_constraintBottom_toTopOf="@+id/layoutActionButtons" />

        <!-- Action Buttons Row (Tashlash, Urish, Bita, Olish) -->
        <LinearLayout
            android:id="@+id/layoutActionButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            app:layout_constraintBottom_toTopOf="@+id/scrollPlayerHand">

            <Button
                android:id="@+id/btnAttack"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#0284C7"
                android:fontFamily="sans-serif-black"
                android:text="⚔️ Tashlash"
                android:textColor="@color/white"
                android:textSize="14sp"
                app:cornerRadius="14dp" />

            <Button
                android:id="@+id/btnDefend"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#16A34A"
                android:fontFamily="sans-serif-black"
                android:text="🛡️ Urish"
                android:textColor="@color/white"
                android:textSize="14sp"
                app:cornerRadius="14dp" />

            <Button
                android:id="@+id/btnPassBita"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#D97706"
                android:fontFamily="sans-serif-black"
                android:text="✋ Bita"
                android:textColor="@color/white"
                android:textSize="14sp"
                app:cornerRadius="14dp" />

            <Button
                android:id="@+id/btnTakeCards"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:backgroundTint="#DC2626"
                android:fontFamily="sans-serif-black"
                android:text="📥 Olish"
                android:textColor="@color/white"
                android:textSize="14sp"
                app:cornerRadius="14dp" />
        </LinearLayout>

        <!-- Player Hand (Bottom Horizontal Scrollable 3D Large Cards with Drag-to-Throw Support) -->
        <HorizontalScrollView
            android:id="@+id/scrollPlayerHand"
            android:layout_width="match_parent"
            android:layout_height="185dp"
            android:fillViewport="true"
            android:paddingHorizontal="10dp"
            android:scrollbars="none"
            app:layout_constraintBottom_toTopOf="@+id/layoutEmotesDurak">

            <LinearLayout
                android:id="@+id/layoutPlayerCards"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="bottom"
                android:orientation="horizontal"
                android:paddingBottom="12dp" />
        </HorizontalScrollView>

        <!-- Emote Bar at bottom -->
        <LinearLayout
            android:id="@+id/layoutEmotesDurak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
